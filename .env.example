# veil-kyc environment template (Day 1: issuer-service attestation)
# Copy to .env and adjust as needed. All variables are optional for the
# local attestation flow; a dev issuer key is generated and persisted under
# issuer-service/.dev/ when ISSUER_PRIVATE_KEY is not set.

# Issuer EdDSA (BabyJubJub) private key, 64 hex chars. Used by
# issuer-service to sign attribute commitments (see README "Circuit Design").
ISSUER_PRIVATE_KEY=

# Directory where `npm run attest` writes attestation JSON files.
ATTESTATION_OUT_DIR=attestations
